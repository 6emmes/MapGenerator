# Makefile for cross‑compiling sdl_2.cpp to Windows using mingw
# Usage: make -f Makefile.win                # builds sdl_2.exe
#        make -f Makefile.win clean           # cleans the binary

CXX      = x86_64-w64-mingw32-g++
CXXFLAGS = -I/home/q/SDL3-win/include
LDFLAGS  = -L/home/q/SDL3-win/lib -lSDL3

TARGETS  = sdl_3.exe
SRCS     = sdl_3.cpp texture.cpp terrain.cpp bmp_write.cpp climate.cpp

all: $(TARGETS)

sdl_2.exe: $(SRCS)
	$(CXX) $(CXXFLAGS) -o $@ $(SRCS) $(LDFLAGS)

sdl_3.exe: $(SRCS)
	$(CXX) $(CXXFLAGS) -o $@ $(SRCS) $(LDFLAGS)

clean:
	rm -f $(TARGETS)

.PHONY: all clean
